// croot data model.
//
// Multi-tenancy: one shared database. Every tenant-owned row carries `organisationId`, and every
// tenant-scoped index leads with it, so queries stay cheap as tenants grow and a later move to
// Postgres row-level security (or sharding by organisation) needs no reshaping. Server code reaches
// tenant data only through `server/src/lib/tenant.ts`, which always filters by organisation.
//
// Privacy boundaries from the design spec are structural, not just UI:
//   - AnonymousNote has no attendee / response / invitation key and no time of day (date only, for retention).
//   - Public pages read PublicationRevision snapshots, never Response rows.
//   - Tokens (invite, receipt, session, setup) are stored only as SHA-256 hashes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Platform & tenancy

enum OrganisationStatus {
  /// Self-service sign-up awaiting platform approval: the workspace works, but invitations and public pages stay off.
  pending
  active
  suspended
}

enum LoginCodePurpose {
  signin
  signup
}

enum MemberRole {
  owner
  organiser
}

enum TenantRequestStatus {
  pending
  approved
  declined
}

model Organisation {
  id           String             @id @default(uuid()) @db.Uuid
  slug         String             @unique
  name         String
  status       OrganisationStatus @default(active)
  /// An admin can pause all guest-facing email from this organisation (lib/emailGuard.ts).
  emailPaused     Boolean  @default(false)
  /// Guest-facing emails a day; null means the platform default (ORG_DAILY_EMAIL_LIMIT).
  dailyEmailLimit Int?
  contactEmail String?
  websiteUrl   String?

  // GDPR: the organisation is the data controller for its guests' data; croot is its processor.
  /// Registered legal name of the controller, shown in privacy notices.
  legalName           String?
  /// Postal address of the controller (Art. 13(1)(a)).
  legalAddress        String?
  /// Where guests send privacy requests. Falls back to contactEmail.
  privacyEmail        String?
  /// Data protection officer or EU/UK representative contact, if appointed.
  dpoContact          String?
  /// Processing terms (DPA) version the owner accepted, and when.
  dpaVersion          String?
  dpaAcceptedAt       DateTime?

  // Retention (enforced by server/src/jobs/retention.ts).
  /// Unsubmitted drafts are deleted this many days after their last change.
  draftRetentionDays          Int @default(90)
  /// Guests who never responded are deleted this many days after the programme ends (or after import for properties).
  nonResponderRetentionDays   Int @default(180)
  /// Submitted responses: private feedback is deleted after this many months. Unpublished responses are deleted entirely.
  responseRetentionMonths     Int @default(24)
  /// No longer used (v1.5): photos keep no original copy at all, only the web copy.
  originalPhotoRetentionDays  Int @default(30)
  anonymousNoteRetentionMonths Int @default(24)
  auditRetentionMonths        Int @default(36)

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  domains     OrgDomain[]
  memberships Membership[]
  retreats    Retreat[]
  interestSignups InterestSignup[]
}

/// Custom hostnames (e.g. reviews.balanceandbeyond.co.uk) mapped to a tenant's public site.
model OrgDomain {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  hostname       String       @unique
  createdAt      DateTime     @default(now())
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

/// How an organiser's details were captured.
enum OrganiserRequestSource {
  /// A signed-in person asked to become an organiser; an admin approves or declines.
  request
  /// An admin's one-time invite link; accepting it grants access at once.
  invite
}

/// Someone asking to become an organiser (or accepting an invite), with the details captured first.
/// An admin approves a request, which creates the organisation and makes the person its owner.
model TenantRequest {
  id             String              @id @default(uuid()) @db.Uuid
  /// The signed-in account that asked (null for legacy, anonymous requests).
  userId         String?             @db.Uuid
  source         OrganiserRequestSource @default(request)
  orgName        String
  contactName    String
  email          String
  phone          String?
  country        String?
  /// Rough scale, in the person's words (e.g. "4 retreats, ~60 guests a year").
  volume         String?
  websiteUrl     String?
  message        String?
  declineReason  String?
  /// Which review types the owner wants: itinerary and/or property.
  reviewKinds    ReviewKind[]        @default([])
  /// Version of the platform privacy notice and processing terms the requester acknowledged.
  termsVersion   String?
  status         TenantRequestStatus @default(pending)
  reviewedById   String?             @db.Uuid
  reviewedAt     DateTime?
  organisationId String?             @db.Uuid
  createdAt      DateTime            @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

/// A one-time link an admin creates for a named email. Whoever signs in with that email and fills in
/// their details becomes an organiser (owner of a new organisation, or a member of an existing one).
model OrganiserInvite {
  id                  String     @id @default(uuid()) @db.Uuid
  tokenHash           String     @unique
  email               String
  /// Join this organisation; null = they create their own from the details they fill in.
  organisationId      String?    @db.Uuid
  role                MemberRole @default(owner)
  createdById         String     @db.Uuid
  expiresAt           DateTime
  usedAt              DateTime?
  usedByUserId        String?    @db.Uuid
  revokedAt           DateTime?
  createdAt           DateTime   @default(now())

  @@index([email])
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  phone           String?
  passwordHash    String?
  /// Google account id (OIDC `sub`), once the user has signed in with Google.
  googleSub       String?   @unique
  /// Set when the user proved control of the email address (email code or Google-verified email).
  emailVerifiedAt DateTime?
  isPlatformAdmin Boolean   @default(false)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  lastLoginAt     DateTime?

  memberships Membership[]
  sessions    Session[]
  setupTokens SetupToken[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  organisationId String       @db.Uuid
  role           MemberRole   @default(organiser)
  /// How many anonymous notes this person has seen per programme ({ retreatId: count }), so the bell can say "new".
  seenNoteCounts Json         @default("{}")
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  csrfToken  String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// One-time sign-in / sign-up code sent by email. Only an HMAC of the code is stored.
model LoginCode {
  id         String           @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String
  purpose    LoginCodePurpose
  /// Sign-up only: the name the person gave.
  name       String?
  attempts   Int              @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime         @default(now())

  @@index([email, createdAt])
  @@index([expiresAt])
}

/// One-time link to set a password (new tenant owner, new organiser, or reset).
model SetupToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String    @unique
  userId    String    @db.Uuid
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------------------------------------
// Retreats

/// itinerary: a hosted group journey with fixed dates and a route (one cohort of guests).
/// property: a retreat venue collecting reviews from guests across many individual stays.
enum ReviewKind {
  itinerary
  property
}

enum RetreatStatus {
  draft
  collecting
  closed
  archived
}

model Retreat {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @db.Uuid
  slug           String
  kind           ReviewKind    @default(itinerary)
  title          String
  /// Required for itinerary retreats; null for properties (each guest has their own stay dates).
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  /// Property only: address or area shown in the public details panel.
  propertyAddress String?
  /// Property only: up to six facilities or highlights.
  amenities      String[]      @default([])
  locationSummary String       @default("")
  /// Up to four short lines describing the route.
  routeSummary   String[]      @default([])
  itineraryUrl   String?
  retreatPageUrl String?
  organiserName  String        @default("")
  contactEmail   String?
  contactPhone   String?
  /// Contact details are shown publicly only once the organiser has previewed and enabled them.
  contactPublic  Boolean       @default(false)
  privacyUrl     String?
  status         RetreatStatus @default(draft)
  inviteOpensAt  DateTime?
  inviteClosesAt DateTime?
  inviteTtlDays  Int           @default(60)
  /// The group link (one link for the whole group): only its hash is kept. Null when there is none.
  groupLinkTokenHash String?   @unique
  groupLinkCreatedAt DateTime?
  groupLinkExpiresAt DateTime?
  draftEditingEnabled      Boolean @default(true)
  publicReviewsEnabled     Boolean @default(true)
  writingSlideshowEnabled  Boolean @default(false)
  heroSlideshowEnabled     Boolean @default(true)
  showPublicRating         Boolean @default(true)
  /// Itinerary retreats: a photo album unlocked for each guest once they send their review.
  rewardAlbumEnabled       Boolean @default(false)
  /// Optional link to the full album elsewhere (e.g. full-resolution photos), shown once unlocked.
  rewardAlbumUrl           String?
  /// Optional thank-you note shown with the album.
  rewardAlbumNote          String  @default("")
  /// The album's title photo: shown first and largest, and leading the welcome-screen preview.
  rewardAlbumCoverId       String?  @db.Uuid
  /// The album's unguessable link (/album/<token>): anyone with it can view, no sign-in. Made on first
  /// use; the organiser can replace it, which stops the old link working.
  albumShareToken          String?  @unique
  /// [{ key, label }] — private feedback categories for this retreat.
  feedbackCategories Json     @default("[]")
  /// [{ key, label, removedAt }] — categories removed after use; their ratings are kept but hidden.
  removedFeedbackCategories Json @default("[]")
  /// The album memory film's music (shared/film.ts): calm, warm, bright or none.
  filmMusic      String        @default("calm")
  /// How the memory film shows the photos (shared/film.ts): mix, single or dynamic.
  filmStyle      String        @default("mix")
  /// Below this many submitted responses, aggregate scores are hidden to protect identities.
  aggregateThreshold Int      @default(5)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  attendees    Attendee[]
  responses    Response[]
  media        MediaAsset[]
  themes       ThemeRevision[]
  contents     ContentRevision[]
  anonymousNotes AnonymousNote[]
  interestSignups InterestSignup[]

  @@unique([organisationId, slug])
  @@index([organisationId, status])
}

// ---------------------------------------------------------------------------------------------
// Attendees & invitations

model Attendee {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  retreatId      String   @db.Uuid
  name           String
  /// Optional: a guest without one is sent their private link by the organiser (WhatsApp, QR code…).
  email          String?
  /// Property reviews: the guest's own stay. Private; never shown publicly.
  stayStart      DateTime?     @db.Date
  stayEnd        DateTime?     @db.Date
  importBatch    String?
  /// invited: on the organiser's guest list. group_link: joined through the retreat's group link
  /// (the organiser confirms them as a guest before their review can be published).
  source         String   @default("invited")
  guestListConfirmedAt DateTime?
  /// When the guest proved they own their email address (link from Croot, sign-in, or a code).
  /// Cleared when the address changes.
  emailVerifiedAt DateTime?
  /// When the organiser last changed the address (a signal for the review-credibility checks).
  emailChangedAt DateTime?
  createdAt      DateTime @default(now())

  retreat     Retreat      @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  invitations Invitation[]
  response    Response?

  @@unique([retreatId, email])
  @@index([organisationId, retreatId])
}

model Invitation {
  id             String    @id @default(uuid()) @db.Uuid
  organisationId String    @db.Uuid
  attendeeId     String    @db.Uuid
  tokenHash      String    @unique
  /// Last four characters, for organisers to tell links apart. Never the full token.
  tokenHint      String
  issuedAt       DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  openedAt       DateTime?
  lastUsedAt     DateTime?
  /// When Croot emailed this link to the guest (null if the organiser copied it to send themselves).
  emailedAt      DateTime?
  attendee       Attendee  @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([organisationId, attendeeId])
}

// ---------------------------------------------------------------------------------------------
// Responses

enum ResponseStatus {
  draft
  submitted
  /// Organiser asked the guest to revise; the invite link is editable again.
  changes_requested
  withdrawn
}

enum PublicationStatus {
  none
  published
  unpublished
  withdrawn
}

model Response {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  retreatId      String         @db.Uuid
  attendeeId     String         @unique @db.Uuid
  status         ResponseStatus @default(draft)
  /// Optimistic concurrency for draft saves.
  revision       Int            @default(0)
  currentStep    Int            @default(0)

  // 1. Public story candidate
  /// Optional title the guest gives their review.
  storyTitle     String         @default("")
  storyText      String         @default("")
  overallRating  Int?

  // 2. Private feedback (ratings are FeedbackRating rows)
  keepText       String         @default("")
  changeText     String         @default("")

  // 5. Current consent state (history is ConsentEvent)
  consentPublicText Boolean     @default(false)
  consentFirstName  Boolean     @default(false)
  consentFollowUp   Boolean     @default(false)
  consentMarketing  Boolean     @default(false)
  /// "Can the organiser use your photos on their website and social media?" null = not answered yet.
  /// Asked as an explicit Yes/No whenever the guest adds photos; sets publishConsent on each photo.
  consentPhotoMarketing Boolean?
  consentWordingVersion String?

  submittedAt      DateTime?
  /// Set when private feedback was deleted under the retention policy.
  privateDataPurgedAt DateTime?
  /// The guest's words exactly as submitted — organisers can never overwrite this.
  submittedSnapshot Json?
  receiptTokenHash String?      @unique
  organiserMessage String?

  publicationStatus PublicationStatus @default(none)
  /// Generated on first publication only; stable afterwards.
  publicSlug     String?        @unique
  pinned         Boolean        @default(false)
  /// Shown publicly as "Verified email": the guest proved they own the invited address (ReviewVerification).
  verifiedAt     DateTime?
  /// Verification emails the organiser has sent for this review (at most 2).
  verifyRequestsSent Int        @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  retreat      Retreat              @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  attendee     Attendee             @relation(fields: [attendeeId], references: [id], onDelete: Cascade)
  ratings      FeedbackRating[]
  media        MediaAsset[]
  consents     ConsentEvent[]
  publications PublicationRevision[]
  helpfulVotes ReviewHelpful[]
  changeRequests ChangeRequest[]
  verifications ReviewVerification[]
  verificationRequests VerificationRequest[]

  @@index([organisationId, retreatId, status])
  @@index([organisationId, retreatId, publicationStatus])
}

model FeedbackRating {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  responseId     String   @db.Uuid
  categoryKey    String
  /// 1–5; null with notApplicable=false means unanswered.
  score          Int?
  notApplicable  Boolean  @default(false)
  comment        String   @default("")
  response       Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@unique([responseId, categoryKey])
  @@index([organisationId])
}

enum ConsentActor {
  attendee
  organiser
  system
}

model ConsentEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String       @db.Uuid
  responseId     String       @db.Uuid
  /// public_text | first_name | follow_up | marketing | photo:<mediaId>
  scope          String
  granted        Boolean
  wordingVersion String
  actor          ConsentActor
  createdAt      DateTime     @default(now())
  response       Response     @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([organisationId, responseId])
}

enum ChangeRequestKind {
  edit
  withdraw
}

enum ChangeRequestStatus {
  open
  resolved
}

model ChangeRequest {
  id             String              @id @default(uuid()) @db.Uuid
  organisationId String              @db.Uuid
  responseId     String              @db.Uuid
  kind           ChangeRequestKind
  message        String              @default("")
  status         ChangeRequestStatus @default(open)
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?
  response       Response            @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([organisationId, status])
}

enum PublicationEventStatus {
  published
  unpublished
  withdrawn
}

/// Immutable snapshot of exactly what is (or was) public. Public endpoints read only this.
model PublicationRevision {
  id             String                 @id @default(uuid()) @db.Uuid
  organisationId String                 @db.Uuid
  responseId     String                 @db.Uuid
  retreatId      String                 @db.Uuid
  /// The guest's own title for their review, if they gave one.
  title          String?
  storyText      String
  /// Verbatim substring of storyText used by the showcase.
  excerpt        String
  displayName    String?
  overallRating  Int?
  photoIds       String[]               @default([])
  status         PublicationEventStatus
  reason         String?
  reviewerId     String?                @db.Uuid
  createdAt      DateTime               @default(now())
  response       Response               @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([organisationId, retreatId, status])
  @@index([responseId, createdAt])
}

// ---------------------------------------------------------------------------------------------
// Media

enum MediaKind {
  guest
  organiser
  /// Thank-you photo album (itinerary retreats): never public; only guests who sent a review can see it.
  album
}

enum ModerationStatus {
  pending
  approved
  rejected
}

model MediaAsset {
  id             String           @id @default(uuid()) @db.Uuid
  organisationId String           @db.Uuid
  retreatId      String           @db.Uuid
  responseId     String?          @db.Uuid
  kind           MediaKind
  /// Videos: the video file (the same as videoKey). Photos keep no second copy, so null (photos
  /// uploaded before v1.5 had a private 4K copy here; the retention job deletes those).
  originalKey    String?
  /// Metadata-stripped web copy: the only copy of a photo that is stored (a video's poster).
  derivativeKey  String
  /// When it was taken (EXIF or the video's creation time), read before metadata is stripped. Null if unknown.
  takenAt        DateTime?
  mime           String
  sizeBytes      Int
  width          Int
  height         Int
  altText        String           @default("")
  caption        String           @default("")
  credit         String           @default("")
  /// Guest's per-photo publication consent (organiser assets: rights confirmed).
  publishConsent Boolean          @default(false)
  moderation     ModerationStatus @default(pending)
  displayOrder   Int              @default(0)
  focalX         Float            @default(0.5)
  focalY         Float            @default(0.5)
  /// Organiser images: separate switches for the public hero and the writing-time slideshow.
  inHeroSlideshow    Boolean      @default(false)
  inWritingSlideshow Boolean      @default(false)
  /// Organiser images: part of the thank-you album too (album photos always are). Off removes it from the album only.
  inAlbum            Boolean      @default(true)
  /// Guest photos: the guest chose to share it in the group album (seen only by guests who sent a review).
  /// Separate from publishConsent (the public site). Opt-in: false until the guest switches it on.
  albumConsent       Boolean      @default(false)
  /// Position in the thank-you album (separate from the slideshow order).
  albumOrder         Int          @default(0)
  /// Album videos (organisers only): the video file. derivativeKey is then its poster image.
  videoKey           String?
  durationSec        Float?
  removedAt      DateTime?
  /// When an old private 4K copy was deleted (see originalKey).
  originalPurgedAt DateTime?
  createdAt      DateTime         @default(now())

  retreat  Retreat   @relation(fields: [retreatId], references: [id], onDelete: Cascade)
  response Response? @relation(fields: [responseId], references: [id], onDelete: Cascade)
  hearts   PhotoHeart[]

  @@index([organisationId, retreatId, kind])
  @@index([responseId])
}

/// "Found this review helpful". Like hearts: `voterHash` is an HMAC of a random id in the visitor's
/// browser, never an IP address or account. One per review per visitor.
model ReviewHelpful {
  responseId String   @db.Uuid
  voterHash  String
  response   Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@id([responseId, voterHash])
}

/// A heart on an album photo. Visitors needn't sign in: `voterHash` is an HMAC of a random ID kept in
/// their browser, never an IP address or account. One per photo per visitor.
model PhotoHeart {
  photoId   String     @db.Uuid
  voterHash String
  photo     MediaAsset @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@id([photoId, voterHash])
}

// ---------------------------------------------------------------------------------------------
// Anonymous notes — deliberately unlinked.

/// Only the words, which retreat they're about and the day they arrived: no guest, response, invitation,
/// category or time of day. The id is random, so it carries no order either.
/// Someone who asked to hear about an organiser's next retreat. Only confirmed rows are emailed;
/// unsubscribing deletes the row. `retreatId` is the page they signed up from.
model InterestSignup {
  id             String        @id @default(uuid()) @db.Uuid
  organisationId String        @db.Uuid
  retreatId      String?       @db.Uuid
  email          String
  name           String        @default("")
  /// Hash of the token in their confirm and unsubscribe links.
  tokenHash      String        @unique
  /// The words they agreed to, as shown when they signed up.
  consentWording String
  confirmedAt    DateTime?
  lastMailAt     DateTime?
  createdAt      DateTime      @default(now())
  organisation   Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  retreat        Retreat?      @relation(fields: [retreatId], references: [id], onDelete: SetNull)

  @@unique([organisationId, email])
}

model AnonymousNote {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  retreatId      String   @db.Uuid
  message        String
  /// Hash of a random key the guest's browser makes per note, so a retried send can't duplicate it.
  sendKeyHash    String?  @unique
  /// Date only, never shown to organisers: used solely to delete the note after the retention period.
  receivedOn     DateTime @default(dbgenerated("CURRENT_DATE")) @db.Date
  retreat        Retreat  @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@index([organisationId, retreatId])
}

// ---------------------------------------------------------------------------------------------
// Public site content

enum RevisionStatus {
  draft
  published
  archived
}

model ThemeRevision {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  retreatId      String         @db.Uuid
  name           String
  presetKey      String
  tokens         Json
  status         RevisionStatus @default(draft)
  actorId        String?        @db.Uuid
  createdAt      DateTime       @default(now())
  retreat        Retreat        @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@index([organisationId, retreatId, status])
}

model ContentRevision {
  id             String         @id @default(uuid()) @db.Uuid
  organisationId String         @db.Uuid
  retreatId      String         @db.Uuid
  headline       String
  introParagraphs String[]      @default([])
  ctaLabel       String         @default("")
  ctaUrl         String         @default("")
  status         RevisionStatus @default(draft)
  /// Optional scheduled go-live; null means live as soon as published.
  publishAt      DateTime?
  actorId        String?        @db.Uuid
  createdAt      DateTime       @default(now())
  retreat        Retreat        @relation(fields: [retreatId], references: [id], onDelete: Cascade)

  @@index([organisationId, retreatId, status])
}

// ---------------------------------------------------------------------------------------------
// Audit

model AuditEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String?  @db.Uuid
  actorUserId    String?  @db.Uuid
  actorKind      String
  action         String
  entityType     String
  entityId       String?
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())

  @@index([organisationId, createdAt])
  @@index([entityType, entityId])
}

/// Platform-wide settings, edited on the Admin screen. A single row (id 1).
model PlatformSettings {
  id             Int      @id @default(1)
  /// Most photos an organiser can put in one retreat's album (their uploads and earlier images). Guests' photos don't count.
  albumMaxPhotos Int      @default(50)
  /// Most videos an organiser can put in one retreat's album.
  albumMaxVideos Int      @default(5)
  updatedAt      DateTime @updatedAt
}

/// A stored file whose deletion failed (storage briefly unavailable). The daily retention job retries
/// it until it's gone, so an erasure never silently leaves a photo behind.
model PendingStorageDeletion {
  key       String   @id
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmailProblem {
  bounced
  complained
}

/// An address never mailed again: SES reported a permanent bounce or a spam complaint.
model EmailSuppression {
  email     String       @id
  reason    EmailProblem
  detail    String       @default("")
  createdAt DateTime     @default(now())
}

/// Guest-facing email an organisation sent (for its daily limit, and to tie SES feedback to it).
model EmailSend {
  id             String   @id @default(uuid()) @db.Uuid
  organisationId String   @db.Uuid
  category       String
  messageId      String?  @unique
  sentAt         DateTime @default(now())

  @@index([organisationId, sentAt])
}

/// A bounce or complaint, per organisation when known (admins' spike alert).
model EmailFeedback {
  id             String       @id @default(uuid()) @db.Uuid
  organisationId String?      @db.Uuid
  kind           EmailProblem
  createdAt      DateTime     @default(now())

  @@index([organisationId, createdAt])
}

enum VerificationMethod {
  /// Sent through a link Croot emailed to the address.
  email_link
  /// Signed in with the address (email code or Google).
  sign_in
  /// Entered a code Croot emailed to the address (thank-you page, or joining by group link).
  code
  /// Confirmed from a verification email the organiser asked Croot to send.
  organiser_request
}

/// One verification of a review: how, when, and signals for later credibility checks. Never the address
/// itself, only its hash, so checks can match addresses across reviews without storing them again.
model ReviewVerification {
  id             String             @id @default(uuid()) @db.Uuid
  organisationId String             @db.Uuid
  responseId     String             @db.Uuid
  method         VerificationMethod
  emailHash      String
  /// Who typed the address: the organiser (guest list) or the guest (group link).
  addressSource  String
  /// e.g. { addressIsMember, addressChangedAfterSent, sameDomainOnRetreat, minutesToWrite }
  signals        Json               @default("{}")
  createdAt      DateTime           @default(now())

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
  @@index([organisationId, createdAt])
  @@index([emailHash])
}

/// A verification email the organiser asked Croot to send: one link, single use.
model VerificationRequest {
  id         String    @id @default(uuid()) @db.Uuid
  responseId String    @db.Uuid
  tokenHash  String    @unique
  /// The address it was sent to (hash): it only verifies while the guest still has that address.
  emailHash  String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  response Response @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([responseId])
}

/// A code emailed to someone joining by a retreat's group link, before they're added as a guest.
model GroupJoinCode {
  id         String    @id @default(uuid()) @db.Uuid
  retreatId  String    @db.Uuid
  email      String
  name       String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([retreatId, email, createdAt])
  @@index([expiresAt])
}
