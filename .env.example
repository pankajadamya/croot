# croot — copy to .env for local development. Never commit .env.
DATABASE_URL="postgresql://croot_app:changeme@localhost:5432/croot?schema=public"

# API port and the Vite dev-server port (avoid 6000: browsers block it).
PORT=6021
WEB_PORT=6020
NODE_ENV=development

# Canonical public origin of the platform (CORS/CSRF allowlist, links shown to organisers).
WEB_ORIGIN=http://localhost:6020
# Hostnames that serve the platform itself rather than a tenant's custom domain (comma-separated).
PLATFORM_HOSTS=localhost,127.0.0.1

# Signs nothing secret-bearing today but reserved for cookie signing; 32+ random bytes, hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Image storage: "local" (development) or "s3". Production uses OVHcloud Object Storage (Paris): a private,
# versioned bucket; every image is served through the app, which checks consent per request.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# For OVHcloud: S3_ENDPOINT=https://s3.eu-west-par.io.cloud.ovh.net, S3_REGION=eu-west-par, S3_FORCE_PATH_STYLE=false
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Seed: first platform admin (local only; use fictional data).
SEED_ADMIN_EMAIL=admin@croot.test
SEED_ADMIN_PASSWORD=

# Sign-in. AUTH_SECRET keys sign-in code hashes and the Google state cookie (32+ random chars, required in production).
AUTH_SECRET=
LOGIN_CODE_TTL_MINUTES=10
# Organiser self-service sign-up (off: onboard organisers with one-time links from /platform).
ORG_SIGNUP_ENABLED=false
SIGNUP_AUTO_APPROVE=false
# Email, named as in Collab: "console" prints codes to the API log (development only); "ses" (Amazon SES v2)
# for real delivery; "resend" also supported. SES needs an IAM user allowed only ses:SendEmail.
EMAIL_PROVIDER=console
EMAIL_FROM="croot <no-reply@mail.snaprows.dev>"
SES_REGION=
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_CONFIGURATION_SET=
RESEND_API_KEY=
# Google sign-in: an OAuth client (Web application). Authorised JavaScript origin = WEB_ORIGIN
# (http://localhost:6020 locally); authorised redirect URI = GOOGLE_CALLBACK_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:6020/api/auth/google/callback
